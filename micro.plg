<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
  <!ENTITY name       "micro">
  <!ENTITY author     "zwinout">
  <!ENTITY version    "2026.09.12.1">
  <!ENTITY microver   "2.0.15">
  <!ENTITY microsha   "267d238eac1e26ed053d13d4d48bd421b87f9eb538b604f0b2f74a85598b6cc2">
  <!ENTITY gitURL     "https://github.com/zwinout/unraid-micro">
  <!ENTITY rawURL     "https://raw.githubusercontent.com/zwinout/unraid-micro/main">
  <!ENTITY pluginURL  "&rawURL;/micro.plg">
  <!ENTITY supportURL "https://github.com/zwinout/unraid-micro/issues">
  <!ENTITY releaseDIR "https://github.com/micro-editor/micro/releases/download/v&microver;">
]>

<PLUGIN
  name="&name;"
  author="&author;"
  version="&version;"
  pluginURL="&pluginURL;"
  support="&supportURL;"
  project="&gitURL;"
  readme="&gitURL;#readme"
  icon="&rawURL;/icon.png"
  min="6.12.0"
>

<DESCRIPTION>
Installs micro, a modern and intuitive terminal-based text editor, so it is available in the Unraid web terminal and over SSH.
</DESCRIPTION>

<CHANGES>
2026.09.12.1
- Support link now points at the issue tracker instead of a forum topic

2026.09.12
- Initial release
- Installs micro 2.0.15 (upstream statically linked linux64 build) to /usr/local/bin/micro
- Verifies the release archive against the upstream SHA256 before installing
- Caches the verified archive on the flash drive, so reinstalls work with GitHub unreachable
- Keeps micro settings and Lua plugins on the flash drive so they survive reboots
</CHANGES>

<!-- Reference copy of the release archive. Unraid downloads this once at install
     time; the installer below re-verifies it and only falls back to a download
     if it is missing or the checksum does not match. -->
<FILE Name="/boot/config/plugins/&name;/micro-&microver;-linux64-static.tar.gz">
  <URL>&releaseDIR;/micro-&microver;-linux64-static.tar.gz</URL>
</FILE>

<FILE Run="/bin/bash" Method="install">
  <INLINE>
#!/bin/bash
#
# micro - Unraid plugin installer.
# Runs once at install time and again on every boot (Unraid's root filesystem
# is a RAM disk, so /usr/local/bin is repopulated each startup).
#
set -euo pipefail

PLUGIN="&name;"
VERSION="&microver;"
TARBALL="micro-${VERSION}-linux64-static.tar.gz"
URL="&releaseDIR;/${TARBALL}"
SHA256="&microsha;"

PLUGIN_DIR="/boot/config/plugins/${PLUGIN}"
CACHE="${PLUGIN_DIR}/${TARBALL}"
CONF_DIR="${PLUGIN_DIR}/config"
BIN="/usr/local/bin/micro"
MANDIR="/usr/local/share/man/man1"
WORK="/tmp/${PLUGIN}-install"

log() { echo "[${PLUGIN}] $*"; }

checksum_ok() {
  [ -f "$1" ] || return 1
  [ "$(sha256sum "$1" | cut -d' ' -f1)" = "$SHA256" ] || return 1
  return 0
}

fetch() {
  if command -v curl >/dev/null 2>/dev/null; then
    curl -fsSL --retry 3 --retry-delay 2 -o "$1" "$2"
    return $?
  fi
  if command -v wget >/dev/null 2>/dev/null; then
    wget -q -O "$1" "$2"
    return $?
  fi
  log "ERROR: neither curl nor wget is available"
  return 127
}

mkdir -p "$PLUGIN_DIR"

if checksum_ok "$CACHE"; then
  log "cached archive ${TARBALL} passed SHA256 verification"
else
  log "cached archive missing or corrupt - downloading ${TARBALL}"
  rm -f "$CACHE"
  if fetch "$CACHE" "$URL"; then
    log "downloaded ${TARBALL}"
  else
    rm -f "$CACHE"
    log "ERROR: download failed - ${URL}"
    exit 1
  fi
  if checksum_ok "$CACHE"; then
    log "download passed SHA256 verification"
  else
    log "ERROR: SHA256 mismatch for ${TARBALL}, refusing to install"
    rm -f "$CACHE"
    exit 1
  fi
fi

rm -rf "$WORK"
mkdir -p "$WORK"
tar -xzf "$CACHE" -C "$WORK" --strip-components=1

if [ ! -f "$WORK/micro" ]; then
  log "ERROR: micro binary not found inside ${TARBALL}"
  exit 1
fi

cp -f "$WORK/micro" "$BIN"
chmod 0755 "$BIN"

mkdir -p "$MANDIR"
if [ -f "$WORK/micro.1" ]; then
  cp -f "$WORK/micro.1" "$MANDIR/micro.1"
fi

# /root only exists on Unraid's RAM disk, so micro's configuration directory is
# redirected to the flash drive. Settings, keybindings and Lua plugins then
# survive a reboot instead of silently resetting every time.
mkdir -p "$CONF_DIR" /root/.config
if [ -L /root/.config/micro ]; then
  :
elif [ -d /root/.config/micro ]; then
  cp -a /root/.config/micro/. "$CONF_DIR/" 2>/dev/null || true
  rm -rf /root/.config/micro
  ln -s "$CONF_DIR" /root/.config/micro
else
  rm -f /root/.config/micro
  ln -s "$CONF_DIR" /root/.config/micro
fi

# Drop archives cached by earlier plugin versions.
find "$PLUGIN_DIR" -maxdepth 1 -type f -name "micro-*-linux64-static.tar.gz" -not -name "${TARBALL}" -delete || true

rm -rf "$WORK"

"$BIN" --version 2>/dev/null | head -n 1 || true
log "micro ${VERSION} installed at ${BIN}"
  </INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
  <INLINE>
#!/bin/bash
#
# micro - Unraid plugin remover.
#
set -uo pipefail

PLUGIN="&name;"
PLUGIN_DIR="/boot/config/plugins/${PLUGIN}"

rm -f /usr/local/bin/micro
rm -f /usr/local/share/man/man1/micro.1

# Only the symlink is removed. Settings are deliberately left on the flash
# drive so a reinstall keeps the user's configuration.
if [ -L /root/.config/micro ]; then
  rm -f /root/.config/micro
fi

echo "[${PLUGIN}] removed. Settings kept in ${PLUGIN_DIR}/config"
  </INLINE>
</FILE>

</PLUGIN>
